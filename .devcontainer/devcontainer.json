{
  // GitHub Codespaces settings for this repository.
  // When a codespace starts, the DB and the app are started automatically.
  // Port 8080 is forwarded (and the browser opened) only once the app is
  // actually listening, so the page is never opened while the app is starting.
  "name": "onboarding-progress-system",

  // Java 21 only (about 2 GB). The former "universal" image includes many languages and is
  // over 10 GB, which made the codespace slow to build (and sometimes it never finished).
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",

  // Added on top of the image: Maven (for building and testing from the terminal)
  // and Docker (to run the DB and the app with Docker Compose)
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "portsAttributes": {
    "8080": {
      "label": "Onboarding app",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },

  // Runs every time the codespace starts (also after it was stopped and resumed)
  "postStartCommand": "bash .devcontainer/start-app.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack"
      ]
    }
  }
}
